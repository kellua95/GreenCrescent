@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>لوحة التحكم</PageTitle>

<div class="dashboard-page" dir="rtl">
    <header class="dashboard-header">
        <span>جمعية الهلال الأخضر الخيرية</span>
        <h1>لوحة التحكم</h1>
        <p>الوصول السريع إلى أقسام إدارة الكفالات.</p>
    </header>

    <section class="dashboard-links">
        <a href="/sponsors">
            <strong>إدارة الكفلاء</strong>
            <span>إضافة الكفلاء والبحث في سجلاتهم.</span>
        </a>

        <a href="/beneficiaries">
            <strong>إدارة المكفولين</strong>
            <span>إضافة المكفولين ومتابعة حالاتهم.</span>
        </a>

        <a href="/sponsorships">
            <strong>إدارة الكفالات</strong>
            <span>إنشاء الكفالات ومتابعة تواريخها.</span>
        </a>

        <a href="/sponsorship-actions">
            <strong>إجراءات الكفالات</strong>
            <span>الاستبدال والإيقاف وتغيير قيمة الكفالة.</span>
        </a>

        <a href="/financial-entry">
            <strong>الإدخال المالي</strong>
            <span>تسجيل الدفعات والتبرعات المالية.</span>
        </a>

        <a href="/reports">
            <strong>التقارير</strong>
            <span>استعراض وطباعة وتصدير التقارير.</span>
        </a>
    </section>
</div>