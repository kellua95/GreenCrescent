@page "/financial-entry"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using GreenCrescent.Application.Features.FinancialEntries
@using GreenCrescent.Application.Features.Sponsors
@using GreenCrescent.Core.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Staff")]
@inject IFinancialEntryService FinancialEntryService
@inject ISponsorService SponsorService
@implements IDisposable

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@inject ProtectedSessionStorage ReceiptStorage
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<FinancialEntry> Logger

<PageTitle>إدخال مالي</PageTitle>

<div class="sponsors-page" dir="rtl">
    <header class="page-header">
        <div>
            <span class="section-label">الحركات المالية</span>
            <h1>إدخال مالي</h1>
            <p>تسجيل التبرعات ودفعات الكفالات.</p>
        </div>
    </header>

    @if (message is not null)
    {
        <div class="alert success-alert">@message</div>
    }

    @if (errorMessage is not null)
    {
        <div class="alert error-alert">@errorMessage</div>
    }
    @if (receiptStorageWarning is not null)
    {
        <div class="alert" role="status">
            @receiptStorageWarning
        </div>
    }

    <section class="finance-grid">
        <div class="form-card finance-form">
        
            <EditForm Model="@form"
                      OnValidSubmit="SaveAsync"
                      FormName="FinancialEntryForm"
                      class="app-form">
                <DataAnnotationsValidator />
                <fieldset disabled="@(isSaving || isCheckingReceipt || saveOutcomeUnknown || !receiptStorageReady)"
                      style="border: 0; padding: 0; margin: 0; min-width: 0;">
                        <div class="form-field">
                            <label>
                                <InputCheckbox @bind-Value="isCancelledReceipt"
                                               @bind-Value:after="CancelledReceiptChanged" />
                                تسجيل وصل ملغي
                            </label>
                        </div>

                        @if (isCancelledReceipt)
                        {
                            <div class="alert">
                                سيُسجّل الوصل بقيمة صفر دون التأثير على رصيد كافل
                                أو تمديد أي كفالة.
                            </div>
                        }
                        @if (!isCancelledReceipt)
                        {
                        <div class="form-field">
                            <label>نوع الإدخال <span>*</span></label>

                            <select value="@((int)form.EntryType)"
                                    @onchange="EntryTypeChanged">
                                @foreach (var type in EntryTypes)
                                {
                                    <option value="@((int)type)">
                                        @GetEntryTypeName(type)
                                    </option>
                                }
                            </select>
                        </div>

                            @if (IsSponsorshipPayment)
                            {
                                <div class="form-field autocomplete">
                                    <label>الكافل <span>*</span></label>

                                    <input value="@sponsorSearch"
                                    @oninput="SponsorSearchChanged"
                                    placeholder="ابحث باسم الكافل أو الهاتف" />

                                    @if (sponsorResults.Count > 0)
                                    {
                                        <div class="search-results">
                                            @foreach (var sponsor in sponsorResults)
                                            {
                                                <button type="button"
                                                @onclick="() => SelectSponsorAsync(sponsor)">
                                                    <strong>@sponsor.Name</strong>
                                                    <small>
                                                        @(sponsor.PhoneNumber ?? "دون هاتف")
                                                        — @sponsor.ActiveSponsorshipsCount كفالة
                                                    </small>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>

                                @if (selectedSponsor is not null)
                                {
                                    <div class="selected-record">
                                        <span>الكافل المختار</span>
                                        <strong>@selectedSponsor.Name</strong>
                                        <small>
                                            عدد الكفالات الفعالة:
                                            @selectedSponsor.ActiveSponsorshipsCount
                                        </small>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="form-field">
                                    <label>اسم المتبرع <span>*</span></label>

                                    <InputText @bind-Value="form.DonorName"
                                    placeholder="اكتب اسم المتبرع" />

                                    <ValidationMessage For="() => form.DonorName" />
                                </div>
                            }

                            <div class="form-field">
                                <label>القيمة المالية <span>*</span></label>

                                <div class="money-input">
                                    <input type="number"
                                    min="0.001"
                                    step="0.001"
                                    value="@form.Amount"
                                    @oninput="AmountChanged"
                                    dir="ltr"
                                    placeholder="0.000" />

                                    <span>د.أ</span>
                                </div>

                                <ValidationMessage For="() => form.Amount" />

                                @if (previewLoading)
                                {
                                    <small class="field-hint">
                                        جاري احتساب مدة الكفالة...
                                    </small>
                                }

                                @if (previewError is not null)
                                {
                                    <div class="validation-message">
                                        @previewError
                                    </div>
                                }
                            </div>

                            <div class="form-field">
                                <label>طريقة الدفع <span>*</span></label>

                                <InputSelect @bind-Value="form.PaymentMethod">
                                    @foreach (var method in PaymentMethods)
                                    {
                                        <option value="@method">
                                            @GetPaymentMethodName(method)
                                        </option>
                                    }
                                </InputSelect>
                            </div>

                        }
                <div class="two-columns">
                    <div class="form-field">
                        <label>رقم الدفتر</label>

                        <InputText @bind-Value="form.BookNumber"
                                   @bind-Value:after="PersistReceiptPositionAsync"
                                   disabled="@(!receiptStorageReady || isSaving)"
                                   maxlength="50" />

                        <ValidationMessage For="() => form.BookNumber" />
                    </div>

                    <div class="form-field">
                        <label>رقم الوصل</label>

                        <InputText @bind-Value="form.ReceiptNumber"
                                   @bind-Value:after="PersistReceiptPositionAsync"
                                   disabled="@(!receiptStorageReady || isSaving)"
                                   maxlength="50" />

                        <ValidationMessage For="() => form.ReceiptNumber" />
                    </div>
                </div>

                <div class="form-field">
                    <label>التاريخ <span>*</span></label>

                    <InputDate @bind-Value="form.EntryDate" />
                </div>

                <div class="form-field">
                        <label>
                            @(isCancelledReceipt ? "سبب إلغاء الوصل *" : "ملاحظات")
                        </label>

                    <InputTextArea @bind-Value="form.Notes"
                                       placeholder=@(isCancelledReceipt ? "سبب إلغاء الوصل *" : "ملاحظات") />

                    <ValidationMessage For="() => form.Notes" />
                </div>

                <div class="form-actions">
                    <button class="primary-button"
                            type="submit"
                            disabled="@isSaving">
                        @(isSaving ? "جاري الحفظ..." : "تأكيد الحركة")
                    </button>

                    <button class="cancel-button"
                            type="button"
                            disabled="@isSaving"
                            @onclick="ResetForm">
                        تفريغ الحقول
                    </button>
                </div>
                </fieldset>
            </EditForm>

            @if (checkedReceipt is { } receipt)
            {
                <section class="list-card" style="padding: 1rem; margin-top: 1rem;">
                    <h3>الحركة المسجلة لهذا الوصل</h3>

                    <p>رقم الحركة: <strong>@receipt.Id</strong></p>
                    <p>الدفتر: @receipt.BookNumber — الوصل: @receipt.ReceiptNumber</p>
                    <p>المتبرع / الكافل: @receipt.DonorName</p>
                    <p>
                        النوع: @(receipt.Status == FinancialEntryStatus.Cancelled
                                ? "وصل ملغي"
                                : GetEntryTypeName(receipt.EntryType))
                    </p>
                    <p>المبلغ: @receipt.Amount.ToString("0.000") د.أ</p>
                    <p>
                        طريقة الدفع:  @(receipt.Status == FinancialEntryStatus.Cancelled
                                ? "—"
                                : GetPaymentMethodName(receipt.PaymentMethod))
                    </p>
                    <p>التاريخ: @receipt.EntryDate.ToString("yyyy/MM/dd")</p>
                    <p>
                        الحالة:
                        @(receipt.Status switch
                        {
                            FinancialEntryStatus.Confirmed => "مؤكدة",
                            FinancialEntryStatus.Reversed => "معكوسة",
                            FinancialEntryStatus.Cancelled => "وصل ملغي",
                            _ => receipt.Status.ToString()
                        })
                    </p>
                    <p>ملاحظات: @(receipt.Notes ?? "—")</p>

                    @if (receipt.Status != FinancialEntryStatus.Reversed)
                    {
                        <a class="edit-button"
                           href="@($"/financial-entry/edit/{receipt.Id}")">
                            تعديل الحركة
                        </a>
                    }
                    <div style="margin-bottom: 1rem;"></div>

                    <p>
                        إذا كانت البيانات مختلفة عن الحركة المقصودة،
                        فلا تعِد استخدامها بهذا الوصل.
                    </p>
                    <button type="button"
                            class="primary-button"
                            disabled="@(isSaving || isCheckingReceipt)"
                            @onclick="ContinueAfterCheckedReceiptAsync">
                        راجعت الحركة — تجهيز الوصل التالي
                    </button>
                </section>
            }

            <div class="no-print" style="margin-top: 1rem;">
                <button type="button"
                        class="primary-button"
                        disabled="@(isSaving || isCheckingReceipt || !receiptStorageReady)"
                        @onclick="CheckReceiptAsync">
                    @(isCheckingReceipt
                        ? "جاري التحقق..."
                        : "التحقق من حفظ الوصل")
                </button>
            </div>
        </div>



        <div class="preview-card">
            <div class="preview-header">
                <span class="section-label">المعاينة</span>
                <h2>توزيع دفعة الكفالة</h2>
            </div>
            @if (isCancelledReceipt)
            {
                <div class="empty-state">
                    <strong>وصل ملغي — 0.000 د.أ</strong>
                    <span>لا توجد دفعة أو توزيعات كفالات.</span>
                </div>
            }
            else if (!IsSponsorshipPayment)
            {
                <div class="empty-state">
                    <strong>هذه الحركة لا تمدد كفالة</strong>
                    <span>ستُسجل كتبرع مالي فقط.</span>
                </div>
            }
            else if (selectedSponsor is null)
            {
                <div class="empty-state">
                    <strong>اختر الكافل</strong>
                    <span>ستظهر جميع كفالاته الفعالة هنا.</span>
                </div>
            }
            else if (preview is null)
            {
                <div class="empty-state">
                    <strong>أدخل قيمة الدفعة</strong>
                    <span>
                        ستُجمع الدفعة مع رصيد الكافل السابق،
                        ثم يُحسب عدد الأشهر الممكن تمديدها.
                    </span>
                </div>
            }
            else
            {
                <div class="preview-summary">
                    <div>
                        <span>الكافل</span>
                        <strong>@preview.SponsorName</strong>
                    </div>

                    <div>
                        <span>المجموع الشهري</span>
                        <strong>
                            @preview.TotalMonthlyAmount.ToString("0.000")
                            د.أ
                        </strong>
                    </div>

                    <div>
                        <span>الرصيد السابق</span>
                        <strong>
                            @preview.PreviousCreditBalance.ToString("0.000")
                            د.أ
                        </strong>
                    </div>

                    <div>
                        <span>الدفعة الجديدة</span>
                        <strong>
                            @preview.PaidAmount.ToString("0.000")
                            د.أ
                        </strong>
                    </div>

                    <div>
                        <span>إجمالي المتاح</span>
                        <strong>
                            @preview.AvailableCredit.ToString("0.000")
                            د.أ
                        </strong>
                    </div>

                    <div>
                        <span>عدد الأشهر المضافة</span>
                        <strong>@preview.AddedMonths</strong>
                    </div>

                    <div>
                        <span>المبلغ المستخدم</span>
                        <strong>
                            @preview.AppliedCredit.ToString("0.000")
                            د.أ
                        </strong>
                    </div>

                    <div>
                        <span>الرصيد المتبقي</span>
                        <strong>
                            @preview.RemainingCredit.ToString("0.000")
                            د.أ
                        </strong>
                    </div>
                </div>

                @if (preview.TotalMonthlyAmount == 0)
                {
                    <div class="alert success-alert">
                        لا توجد كفالات فعالة لهذا الكافل حاليًا.
                        ستُحفظ الدفعة كاملة في رصيده المرحّل.
                    </div>
                }
                else if (preview.AddedMonths == 0)
                {
                    <div class="alert">
                        الرصيد المتاح لم يصل بعد إلى مجموع الكفالات
                        الشهري. ستُحفظ الدفعة في رصيد الكافل دون
                        تمديد الكفالات حاليًا.
                    </div>
                }
                else
                {
                    <div class="alert success-alert">
                        سيتم تمديد جميع الكفالات الفعالة
                        @preview.AddedMonths
                        شهر، وسيبقى للكافل رصيد مقداره
                        @preview.RemainingCredit.ToString("0.000")
                        د.أ.
                    </div>
                }

                @if (preview.Allocations.Count > 0)
                {
                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>المكفول</th>
                                    <th>القيمة الشهرية</th>
                                    <th>النهاية القديمة</th>
                                    <th>النهاية الجديدة</th>
                                    <th>المبلغ المستخدم</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var allocation in preview.Allocations)
                                {
                                    <tr>
                                        <td>
                                            <strong>
                                                @allocation.BeneficiaryName
                                            </strong>

                                            <small class="block">
                                                ملف @allocation.FileNumber
                                            </small>
                                        </td>

                                        <td>
                                            @allocation.MonthlyAmount.ToString("0.000")
                                        </td>

                                        <td>
                                            @allocation.CurrentEndDate.ToString("yyyy/MM/dd")
                                        </td>

                                        <td>
                                            <strong class="new-date">
                                                @allocation.NewEndDate.ToString("yyyy/MM/dd")
                                            </strong>
                                        </td>

                                        <td>
                                            @allocation.AllocatedAmount.ToString("0.000")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            }
        </div>
    </section>
</div>

@code {
    private static readonly FinancialEntryType[] EntryTypes =
        Enum.GetValues<FinancialEntryType>();

    private static readonly PaymentMethod[] PaymentMethods =
        Enum.GetValues<PaymentMethod>();
    private bool saveOutcomeUnknown;

    private FinancialEntryFormModel form = NewForm();

    private IReadOnlyList<SponsorDto> sponsorResults = [];
    private SponsorDto? selectedSponsor;
    private SponsorshipPaymentPreviewDto? preview;

    private string sponsorSearch = string.Empty;
    private string? message;
    private string? errorMessage;
    private string? previewError;

    private bool isSaving;
    private bool previewLoading;

    private CancellationTokenSource? previewCancellation;

    private bool IsSponsorshipPayment =>
        !isCancelledReceipt &&
        (form.EntryType is
            FinancialEntryType.OrphanSponsorship or
            FinancialEntryType.SponsorshipDeliveredByHand);


    private string? receiptStorageKey;
    private bool receiptStorageReady;
    private string? receiptStorageWarning;
    private readonly SemaphoreSlim financialOperationGate = new(1, 1);
    private int sponsorSearchVersion;

    private bool isCancelledReceipt;

    private void CancelledReceiptChanged()
    {
        sponsorSearchVersion++;
        InvalidatePreview();

        selectedSponsor = null;
        sponsorSearch = string.Empty;
        sponsorResults = [];

        form.SponsorId = null;
        form.DonorName = null;
        form.Amount = 0m;
        form.IsCancelledReceipt = isCancelledReceipt;

        errorMessage = null;
        message = null;
    }

    private async Task<T> RunFinancialOperationAsync<T>(
        Func<Task<T>> operation,
        CancellationToken cancellationToken = default)
    {
        await financialOperationGate.WaitAsync(cancellationToken);

        try
        {
            return await operation();
        }
        finally
        {
            financialOperationGate.Release();
        }
    }
    public sealed class ReceiptPosition
    {
        public string? BookNumber { get; set; }
        public string? ReceiptNumber { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var state = await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

            var userId = state.User.FindFirstValue(
                ClaimTypes.NameIdentifier);

            if (state.User.Identity?.IsAuthenticated != true ||
                string.IsNullOrWhiteSpace(userId))
            {
                receiptStorageWarning =
                    "تعذر تحديد الحساب لاسترجاع رقم الدفتر والوصل.";
                return;
            }

            receiptStorageKey = $"gc:receipt-position:{userId}";

            var result = await ReceiptStorage.GetAsync<ReceiptPosition>(
                receiptStorageKey);

            if (result.Success && result.Value is not null)
            {
                form.BookNumber = result.Value.BookNumber;
                form.ReceiptNumber = result.Value.ReceiptNumber;
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Could not restore receipt position.");

            receiptStorageWarning =
                "تعذر استرجاع رقم الدفتر والوصل. أدخلهما يدويًا.";
        }
        finally
        {
            receiptStorageReady = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PersistReceiptPositionAsync()
    {
        if (!receiptStorageReady || receiptStorageKey is null)
        {
            return;
        }

        try
        {
            await ReceiptStorage.SetAsync(
                receiptStorageKey,
                new ReceiptPosition
                {
                    BookNumber = form.BookNumber,
                    ReceiptNumber = form.ReceiptNumber
                });

            receiptStorageWarning = null;
        }
        catch (Exception exception)
        {
            Logger.LogWarning(
                exception,
                "Could not persist receipt position.");

            receiptStorageWarning =
                "تعذر حفظ تسلسل الوصولات في المتصفح؛ دوّن الرقم قبل إعادة تحميل الصفحة.";
        }
    }

    private async Task EntryTypeChanged(ChangeEventArgs args)
    {
        sponsorSearchVersion++;
        InvalidatePreview();

        if (int.TryParse(args.Value?.ToString(), out var value))
        {
            form.EntryType = (FinancialEntryType)value;
        }

        selectedSponsor = null;
        form.SponsorId = null;
        sponsorSearch = string.Empty;
        sponsorResults = [];
        preview = null;
        previewError = null;

        await Task.CompletedTask;
    }

    private async Task SponsorSearchChanged(ChangeEventArgs args)
    {
        if (isSaving)
        {
            return;
        }

        InvalidatePreview();

        var version = ++sponsorSearchVersion;
        var term = args.Value?.ToString() ?? string.Empty;

        sponsorSearch = term;
        selectedSponsor = null;
        form.SponsorId = null;
        form.DonorName = null;
        sponsorResults = [];
        preview = null;
        previewError = null;

        if (string.IsNullOrWhiteSpace(term))
        {
            return;
        }

        try
        {
            // انتظار قصير لتقليل الاستعلامات أثناء الكتابة.
            await Task.Delay(300);

            if (version != sponsorSearchVersion || isSaving)
            {
                return;
            }

            var results = await RunFinancialOperationAsync(
                () => SponsorService.SearchAsync(term));

            // تجاهل نتائج بحث قديم بعد تغيير النص.
            if (version != sponsorSearchVersion || isSaving)
            {
                return;
            }

            sponsorResults = results;
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to search sponsors in financial entry.");

            if (version == sponsorSearchVersion)
            {
                sponsorResults = [];
                previewError =
                    "تعذر البحث عن الكافل. حاول مجددًا؛ رقم الدفتر والوصل لم يتغيرا.";
            }
        }
    }

    private async Task SelectSponsorAsync(SponsorDto sponsor)
    {
        if (isSaving)
        {
            return;
        }

        InvalidatePreview();

        sponsorSearchVersion++;
        selectedSponsor = sponsor;
        form.SponsorId = sponsor.Id;
        form.DonorName = sponsor.Name;
        sponsorSearch = sponsor.Name;
        sponsorResults = [];

        await RefreshPreviewAsync();
    }

    private async Task AmountChanged(ChangeEventArgs args)
    {

        InvalidatePreview();

        var text = args.Value?.ToString();

        if (!decimal.TryParse(
                text,
                NumberStyles.Number,
                CultureInfo.InvariantCulture,
                out var amount))
        {
            decimal.TryParse(
                text,
                NumberStyles.Number,
                CultureInfo.CurrentCulture,
                out amount);
        }

        form.Amount = amount;
        preview = null;
        previewError = null;

        previewCancellation?.Cancel();
        previewCancellation?.Dispose();
        previewCancellation = new CancellationTokenSource();

        var token = previewCancellation.Token;  

        try
        {
            await Task.Delay(350, token);
            await RefreshPreviewAsync(token);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshPreviewAsync(
    CancellationToken cancellationToken = default)
    {
        if (cancellationToken.IsCancellationRequested || isSaving)
        {
            return;
        }

        var version = ++previewVersion;

        preview = null;
        previewError = null;
        previewLoading = false;

        if (!IsSponsorshipPayment ||
            !form.SponsorId.HasValue ||
            form.Amount <= 0)
        {
            return;
        }

        var sponsorId = form.SponsorId.Value;
        var amount = form.Amount;
        var entryType = form.EntryType;

        previewLoading = true;

        try
        {
            var result = await RunFinancialOperationAsync(
                () => FinancialEntryService.PreviewSponsorshipPaymentAsync(
                    sponsorId,
                    amount,
                    cancellationToken),
                cancellationToken);

            if (version != previewVersion ||
                cancellationToken.IsCancellationRequested ||
                isSaving ||
                form.SponsorId != sponsorId ||
                form.Amount != amount ||
                form.EntryType != entryType)
            {
                return;
            }

            preview = result;
        }
        catch (OperationCanceledException)
        {
            // أُلغيت المعاينة بسبب تغيير المدخلات.
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to preview sponsorship payment.");

            if (version == previewVersion)
            {
                previewError =
                    "تعذر احتساب المعاينة. حاول مجددًا.";
            }
        }
        finally
        {
            if (version == previewVersion)
            {
                previewLoading = false;
            }
        }
    }

    private async Task SaveAsync()
    {
        if (isSaving || isCheckingReceipt || !receiptStorageReady)
        {
            return;
        }

        if (saveOutcomeUnknown)
        {
            errorMessage =
                "نتيجة المحاولة السابقة غير مؤكدة. تحقق من سجل الحركات " +
                "برقم الدفتر والوصل قبل إعادة الإدخال.";
            return;
        }

        errorMessage = null;
        message = null;

        if (IsSponsorshipPayment && !form.SponsorId.HasValue)
        {
            errorMessage = "يجب اختيار الكافل من نتائج البحث.";
            return;
        }

        if (!isCancelledReceipt && !IsSponsorshipPayment &&
            string.IsNullOrWhiteSpace(form.DonorName))
        {
            errorMessage = "اسم المتبرع مطلوب.";
            return;
        }

        var cancelledReceipt = isCancelledReceipt;

        if (cancelledReceipt && string.IsNullOrWhiteSpace(form.Notes))
        {
            errorMessage = "سبب إلغاء الوصل مطلوب.";
            return;
        }

        // نسخة ثابتة قبل أي انتظار.
        var request = new CreateFinancialEntryRequest(
            form.SponsorId,
            form.DonorName,
            form.EntryType,
            form.Amount,
            form.PaymentMethod,
            form.BookNumber,
            form.ReceiptNumber,
            form.EntryDate,
            form.Notes);

        isSaving = true;
        sponsorSearchVersion++;
        InvalidatePreview();

        int? savedEntryId = null;

        try
        {
            await PersistReceiptPositionAsync();

            if (cancelledReceipt)
            {
                savedEntryId = await RunFinancialOperationAsync(
                    () => FinancialEntryService.CreateCancelledReceiptAsync(
                        new CreateCancelledReceiptRequest(
                            request.BookNumber!,
                            request.ReceiptNumber!,
                            request.EntryDate,
                            request.Notes!)));
            }
            else
            {
                savedEntryId = await RunFinancialOperationAsync(
                    () => FinancialEntryService.CreateAsync(request));
            }

            // نعيد الرقمين اللذين حُفظت بهما الحركة،
            // ثم نزيد الوصل من خلال الدالة الموجودة.
            form.BookNumber = request.BookNumber;
            form.ReceiptNumber = request.ReceiptNumber;

            ResetFormAfterSuccessfulSave();

            message =
                $"تم تسجيل الحركة المالية رقم {savedEntryId.Value} بنجاح.";

            await PersistReceiptPositionAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to save financial entry or update its form.");

            if (savedEntryId.HasValue)
            {
                // الخدمة أكدت الحفظ؛ المشكلة حصلت بعده.
                saveOutcomeUnknown = true;

                message =
                    $"تم حفظ الحركة المالية رقم {savedEntryId.Value}.";

                errorMessage =
                    "تعذر تجهيز النموذج للحركة التالية. لا تعِد إدخال " +
                    "الحركة المحفوظة؛ أعد فتح الصفحة وراجع رقم الوصل.";
            }
            else if (exception is InvalidOperationException)
            {
                errorMessage = exception.Message;
            }
            else
            {
                // قد يكون الحفظ وصل للخادم قبل انقطاع الاتصال.
                saveOutcomeUnknown = true;

                errorMessage =
                    "تعذر تأكيد نتيجة الحفظ. تحقق من سجل الحركات " +
                    "باستخدام رقم الدفتر والوصل قبل إعادة الإدخال. " +
                    "لم ننتقل إلى الوصل التالي.";
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ResetForm()
    {
        sponsorSearchVersion++;
        InvalidatePreview();

        var bookNumber = form.BookNumber;
        var receiptNumber = form.ReceiptNumber;

        form = NewForm();
        isCancelledReceipt = false;

        form.BookNumber = bookNumber;
        form.ReceiptNumber = receiptNumber;

        selectedSponsor = null;
        sponsorSearch = string.Empty;
        sponsorResults = [];
        preview = null;
        previewError = null;
        errorMessage = null;
    }

    private void ResetFormAfterSuccessfulSave()
    {
        sponsorSearchVersion++;
        InvalidatePreview();

        var currentBookNumber =
            form.BookNumber?.Trim();

        var currentReceiptNumber =
            form.ReceiptNumber?.Trim();

        string? nextReceiptNumber = currentReceiptNumber;

        if (long.TryParse(
                currentReceiptNumber,
                NumberStyles.Integer,
                CultureInfo.InvariantCulture,
                out var receiptNumber) &&
            receiptNumber < long.MaxValue)
        {
            nextReceiptNumber =
                (receiptNumber + 1)
                    .ToString(CultureInfo.InvariantCulture);
        }

        form = NewForm();
        isCancelledReceipt = false;

        form.BookNumber =
            currentBookNumber;

        form.ReceiptNumber =
            nextReceiptNumber;

        selectedSponsor = null;
        sponsorSearch = string.Empty;
        sponsorResults = [];
        preview = null;
        previewError = null;
        errorMessage = null;
    }

    private static FinancialEntryFormModel NewForm()
    {
        return new FinancialEntryFormModel
        {
            EntryType = FinancialEntryType.NewOrphan,
            PaymentMethod = PaymentMethod.Cash,
            EntryDate = DateOnly.FromDateTime(DateTime.Today)
        };
    }

    private static string GetEntryTypeName(
        FinancialEntryType type) => type switch
        {
            FinancialEntryType.NewOrphan => "يتيم جديد",
            FinancialEntryType.Zakat => "زكاة",
            FinancialEntryType.Charity => "صدقة",
            FinancialEntryType.Other => "أخرى",
            FinancialEntryType.OrphanSponsorship => "كفالة يتيم",
            FinancialEntryType.SponsorshipDeliveredByHand =>
                "كفالة سُلّمت باليد",
            _ => type.ToString()
        };

    private static string GetPaymentMethodName(
        PaymentMethod method) => method switch
        {
            PaymentMethod.Cash => "نقدي",
            PaymentMethod.Clearing => "مقاصة",
            PaymentMethod.ByHand => "باليد",
            PaymentMethod.BankTransfer => "تحويل بنكي",
            _ => method.ToString()
        };

    public void Dispose()
    {
        previewCancellation?.Cancel();
        previewCancellation?.Dispose();
    }

    private sealed class FinancialEntryFormModel: IValidatableObject
    {
        public int? SponsorId { get; set; }

        public string? DonorName { get; set; }

        public FinancialEntryType EntryType { get; set; }

        public decimal Amount { get; set; }

        public bool IsCancelledReceipt { get; set; }

        public PaymentMethod PaymentMethod { get; set; }

        [Required(ErrorMessage = "رقم الدفتر مطلوب.")]
        [StringLength(50, ErrorMessage = "رقم الدفتر يجب ألا يتجاوز 50 حرفًا.")]
        public string? BookNumber { get; set; }

        [Required(ErrorMessage = "رقم الوصل مطلوب.")]
        [StringLength(50, ErrorMessage = "رقم الوصل يجب ألا يتجاوز 50 حرفًا.")]
        public string? ReceiptNumber { get; set; }

        public DateOnly EntryDate { get; set; }

        [StringLength(1000)]
        public string? Notes { get; set; }

        public IEnumerable<ValidationResult> Validate(
    ValidationContext validationContext)
        {
            if (IsCancelledReceipt)
            {
                if (Amount != 0m)
                {
                    yield return new ValidationResult(
                        "قيمة الوصل الملغي يجب أن تكون صفرًا.",
                        [nameof(Amount)]);
                }

                if (string.IsNullOrWhiteSpace(Notes))
                {
                    yield return new ValidationResult(
                        "سبب إلغاء الوصل مطلوب.",
                        [nameof(Notes)]);
                }
            }
            else if (Amount < 0.001m || Amount > 999999999999m)
            {
                yield return new ValidationResult(
                    "القيمة يجب أن تكون بين 0.001 و999999999999.",
                    [nameof(Amount)]);
            }
        }
    }

    private bool isCheckingReceipt;
    private FinancialEntryDto? checkedReceipt;

    private async Task CheckReceiptAsync()
    {
        if (isSaving || isCheckingReceipt || !receiptStorageReady)
        {
            return;
        }

        var book = form.BookNumber?.Trim();
        var receipt = form.ReceiptNumber?.Trim();

        if (string.IsNullOrWhiteSpace(book) ||
            string.IsNullOrWhiteSpace(receipt))
        {
            errorMessage = "أدخل رقم الدفتر ورقم الوصل أولًا.";
            return;
        }

        isCheckingReceipt = true;
        checkedReceipt = null;
        errorMessage = null;
        message = null;

        try
        {
            var existing = await RunFinancialOperationAsync(
                () => FinancialEntryService.GetByReceiptAsync(
                    book,
                    receipt));

            if (existing is null)
            {
                saveOutcomeUnknown = false;

                message =
                    "لم نجد حركة بهذا الدفتر والوصل وقت التحقق. " +
                    "راجع بياناتك قبل الضغط على الحفظ.";
            }
            else
            {
                checkedReceipt = existing;
                saveOutcomeUnknown = true;

                message =
                    "هذا الوصل مسجل بالفعل. راجع تفاصيله أدناه؛ " +
                    "لن نعتبره تلقائيًا نفس الحركة التي حاولت إدخالها.";
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to verify financial receipt.");

            errorMessage =
                "تعذر التحقق من الوصل. حاول التحقق مجددًا قبل إعادة الحفظ.";
        }
        finally
        {
            isCheckingReceipt = false;
        }
    }

    private async Task ContinueAfterCheckedReceiptAsync()
    {
        if (checkedReceipt is null || isSaving || isCheckingReceipt)
        {
            return;
        }

        isCheckingReceipt = true;

        try
        {
            form.BookNumber = checkedReceipt.BookNumber;
            form.ReceiptNumber = checkedReceipt.ReceiptNumber;

            ResetFormAfterSuccessfulSave();

            checkedReceipt = null;
            saveOutcomeUnknown = false;

            message =
                "تم تجهيز نموذج جديد بعد الوصل الذي راجعته. " +
                "لم تُسجّل أي حركة إضافية.";

            await PersistReceiptPositionAsync();
        }
        finally
        {
            isCheckingReceipt = false;
        }
    }

    private int previewVersion;

    private void InvalidatePreview()
    {
        previewVersion++;
        previewCancellation?.Cancel();

        preview = null;
        previewError = null;
        previewLoading = false;
    }
}