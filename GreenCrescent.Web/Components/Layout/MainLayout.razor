@inherits LayoutComponentBase

<div class="app-shell" dir="rtl">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="main-content">
        <header class="content-header no-print">
            <button type="button"
                    class="sidebar-toggle"
                    title="فتح أو إغلاق القائمة"
                    aria-label="فتح أو إغلاق القائمة"
                    onclick="document.querySelector('.app-shell').classList.toggle('sidebar-collapsed')">

                <span class="collapse-icon">→</span>
                <span class="open-icon">☰</span>
            </button>
            <div class="organization-name">
                جمعية الهلال الأخضر الخيرية
            </div>
        </header>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui"
     data-nosnippet
     dir="rtl">
    حدث خطأ غير متوقع.

    <a href="." class="reload">
        إعادة تحميل الصفحة
    </a>

    <span class="dismiss">×</span>
</div>